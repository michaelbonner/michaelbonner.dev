{
  "name": "michaelbonner-svelte",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . && prettier --check .",
    "format": "prettier --write .",
    "out": "bun outdated",
    "up": "bun update",
    "preinstall": "npx only-allow bun",
    "test:e2e": "playwright test",
    "test:setup": "bun ./e2e/validate-test-data.js --update",
    "test": "bun test:setup && bun test:e2e"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-highlight": "^7.16.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@qwik.dev/partytown": "^0.14.0",
    "clsx": "^2.1.1",
    "photoswipe": "^5.4.4",
    "posthog-js": "^1.408.0",
    "svelte-turnstile": "^0.11.0"
  }
}
