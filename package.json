{
	"name": "michaelbonner-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && prettier --check .",
		"format": "prettier --write .",
		"out": "bun outdated",
		"up": "bun update",
		"preinstall": "npx only-allow bun",
		"test:e2e": "playwright test",
		"test:setup": "bun ./e2e/validate-test-data.js --update",
		"test": "bun test:setup && bun test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.69.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.2",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"postcss": "^8.5.16",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-highlight": "^7.13.0",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.2",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^8.1.3",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.2.10",
		"@qwik.dev/partytown": "^0.14.0",
		"clsx": "^2.1.1",
		"photoswipe": "^5.4.4",
		"posthog-js": "^1.396.4",
		"svelte-turnstile": "^0.11.0"
	}
}
