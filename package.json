{
	"name": "michaelbonner-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && prettier --check .",
		"format": "prettier --write .",
		"geocode": "bun ./scripts/geocode-restaurants.js",
		"og": "bun ./scripts/generate-og-images.js",
		"out": "bun outdated",
		"up": "bun update",
		"preinstall": "npx only-allow bun",
		"test:e2e": "playwright test",
		"test:setup": "bun ./e2e/validate-test-data.js --update",
		"test": "bun test:setup && bun test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/leaflet": "^1.9.22",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-highlight": "^7.23.1",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.7",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@maplibre/maplibre-gl-leaflet": "^0.1.4",
		"@qwik.dev/partytown": "^1.0.5",
		"clsx": "^2.1.1",
		"leaflet": "^1.9.4",
		"maplibre-gl": "^6.17.0",
		"photoswipe": "^5.4.4",
		"posthog-js": "^1.447.4",
		"svelte-turnstile": "^0.11.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
