{
	"name": "michaelbonner-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && prettier --check .",
		"format": "prettier --write .",
		"geocode": "bun ./scripts/geocode-restaurants.js",
		"og": "bun ./scripts/generate-og-images.js",
		"out": "bun outdated",
		"up": "bun update",
		"preinstall": "npx only-allow bun",
		"test:e2e": "playwright test",
		"test:setup": "bun ./e2e/validate-test-data.js --update",
		"test": "bun test:setup && bun test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/leaflet": "^1.9.22",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-highlight": "^7.20.0",
		"tailwindcss": "^4.3.3",
